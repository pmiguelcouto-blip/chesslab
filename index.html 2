        const ev = minimax(game, depth - 1, alpha, beta, false);
        game.undo();
        maxEval = Math.max(maxEval, ev);
        alpha = Math.max(alpha, ev);
        if (beta <= alpha) break;
      }
      return maxEval;
    } else {
      let minEval = Infinity;
      for (const m of moves) {
        game.move(m);
        const ev = minimax(game, depth - 1, alpha, beta, true);
        game.undo();
        minEval = Math.min(minEval, ev);
        beta = Math.min(beta, ev);
        if (beta <= alpha) break;
      }
      return minEval;
    }
  }

  function pickBotMoveByElo() {
    const elo = parseInt(document.getElementById("bot-elo").value, 10);
    const moves = chess.moves({ verbose: true });
    if (!moves.length) return null;
    if (elo <= 400 && Math.random() < 0.65) return moves[Math.floor(Math.random() * moves.length)];
    if (elo <= 800 && Math.random() < 0.35) return moves[Math.floor(Math.random() * moves.length)];
    const depth = elo >= 2000 ? 3 : elo >= 1200 ? 2 : 1;
    const res = findBestMoveMinimax(chess, depth);
    return res ? res.move : moves[0];
  }

  /* ================= BOARD RENDERING ================= */
  const FILES = ["a", "b", "c", "d", "e", "f", "g", "h"];
  const RANKS = ["8", "7", "6", "5", "4", "3", "2", "1"];

  function renderBoard() {
    const boardEl = document.getElementById("chessboard");
    boardEl.innerHTML = "";
    const ranks = boardFlipped ? [...RANKS].reverse() : RANKS;
    const files = boardFlipped ? [...FILES].reverse() : FILES;
    const lastMove = viewIndex >= 0 && moveHistory[viewIndex] ? moveHistory[viewIndex] : null;
    const ratingInfo = viewIndex >= 0 ? moveRatings[viewIndex] : null;

    ranks.forEach((r, rIdx) => {
      files.forEach((f, fIdx) => {
        const sq = f + r;
        const sqDiv = document.createElement("div");
        const isLight = (FILES.indexOf(f) + RANKS.indexOf(r)) % 2 === 0;
        sqDiv.className = `square ${isLight ? "light" : "dark"}`;
        if (selectedSq === sq) sqDiv.classList.add("selected");
        if (lastMove && (lastMove.from === sq || lastMove.to === sq)) sqDiv.classList.add("last-move");
        if (highlightSquares.hint.includes(sq)) sqDiv.classList.add("hint-sq");
        if (highlightSquares.threat.includes(sq)) sqDiv.classList.add("threat-sq");
        if (highlightSquares.plan.includes(sq)) sqDiv.classList.add("plan-sq");

        if (rIdx === 7) {
          const cf = document.createElement("span");
          cf.className = "coord-file";
          cf.textContent = f;
          sqDiv.appendChild(cf);
        }
        if (fIdx === 0) {
          const cr = document.createElement("span");
          cr.className = "coord-rank";
          cr.textContent = r;
          sqDiv.appendChild(cr);
        }

        const piece = chess.get(sq);
        if (piece) {
          const key = piece.color + piece.type.toUpperCase();
          const wrap = document.createElement("div");
          wrap.className = "piece-svg";
          wrap.innerHTML = PIECE_SVGS[key] || "";
          sqDiv.appendChild(wrap);
        }

        if (legalTargets.includes(sq)) {
          const dot = document.createElement("div");
          dot.className = piece ? "legal-ring" : "legal-dot";
          sqDiv.appendChild(dot);
        }

        if (ratingInfo && lastMove && lastMove.to === sq) {
          const badge = document.createElement("div");
          badge.className = `sq-badge ${ratingInfo.css}`;
          badge.textContent = ratingInfo.symbol;
          sqDiv.appendChild(badge);
        }

        sqDiv.onclick = () => onSquareClick(sq);
        boardEl.appendChild(sqDiv);
      });
    });

    drawArrow();
    updateEvalBar();
  }

  function drawArrow() {
    const svg = document.getElementById("arrow-overlay");
    svg.innerHTML = "";
    if (!currentArrow) return;
    const { from, to, color = "#10b981" } = currentArrow;
    const getCenter = (sq) => {
      let fi = FILES.indexOf(sq[0]);
      let ri = RANKS.indexOf(sq[1]);
      if (boardFlipped) { fi = 7 - fi; ri = 7 - ri; }
      return { x: fi * 100 + 50, y: ri * 100 + 50 };
    };
    const p1 = getCenter(from);
    const p2 = getCenter(to);
    svg.innerHTML = `
      <defs>
        <marker id="arrowhead" markerWidth="4" markerHeight="4" refX="2.5" refY="2" orient="auto">
          <polygon points="0 0, 4 2, 0 4" fill="${color}" />
        </marker>
      </defs>
      <line x1="${p1.x}" y1="${p1.y}" x2="${p2.x}" y2="${p2.y}" stroke="${color}" stroke-width="14" stroke-linecap="round" opacity="0.88" marker-end="url(#arrowhead)" />
    `;
  }

  function updateEvalBar() {
    const cp = evaluateBoardStatic(chess);
    const clamped = Math.max(-1000, Math.min(1000, cp));
    const pct = 50 + (clamped / 1000) * 45;
    document.getElementById("eval-fill").style.height = `${pct}%`;
    document.getElementById("eval-text").textContent = (cp / 100).toFixed(1);
  }

  /* ================= MOVE EXECUTION & LIVE COACH ================= */
  function onSquareClick(sq) {
    if (viewIndex < moveHistory.length - 1 && !inSimulation && gameMode !== "puzzle") {
      goToMove(moveHistory.length - 1);
    }

    if (selectedSq) {
      if (selectedSq === sq) {
        selectedSq = null;
        legalTargets = [];
        renderBoard();
        return;
      }
      if (legalTargets.includes(sq)) {
        const piece = chess.get(selectedSq);
        const isPromo = piece && piece.type === "p" && ((piece.color === "w" && sq[1] === "8") || (piece.color === "b" && sq[1] === "1"));
        if (isPromo) {
          openPromotionModal(selectedSq, sq, piece.color);
          return;
        }
        attemptMove(selectedSq, sq, "q");
        return;
      }
    }

    const piece = chess.get(sq);
    if (piece && piece.color === chess.turn()) {
      if (gameMode === "bot" && piece.color === "b") return;
      selectedSq = sq;
      legalTargets = chess.moves({ square: sq, verbose: true }).map(m => m.to);
    } else {
      selectedSq = null;
      legalTargets = [];
    }
    renderBoard();
  }

  function openPromotionModal(from, to, color) {
    const modal = document.getElementById("promo-modal");
    const box = document.getElementById("promo-choices");
    box.innerHTML = "";
    ["q", "r", "b", "n"].forEach(type => {
      const btn = document.createElement("button");
      btn.className = "promo-btn";
      btn.innerHTML = PIECE_SVGS[color + type.toUpperCase()];
      btn.onclick = () => {
        modal.classList.remove("open");
        attemptMove(from, to, type);
      };
      box.appendChild(btn);
    });
    modal.classList.add("open");
  }

  function attemptMove(from, to, promotion = "q") {
    if (gameMode === "puzzle") {
      handlePuzzleUserMove(from, to, promotion);
      return;
    }

    const beforeEval = evaluateBoardStatic(chess);
    const bestBefore = liveCoachEnabled ? findBestMoveMinimax(chess, 2) : null;
    const moverColor = chess.turn();

    const move = chess.move({ from, to, promotion });
    if (!move) return;

    selectedSq = null;
    legalTargets = [];
    clearBoardHighlights(false);

    if (!inSimulation) {
      moveHistory.push(move);
      viewIndex = moveHistory.length - 1;
      renderMoveList();
    }

    playSound(chess.in_check() ? "check" : move.captured ? "capture" : "move");
    renderBoard();

    if (liveCoachEnabled && !inSimulation && (gameMode === "pvp" || moverColor === "w")) {
      evaluateMoveForLiveCoach(move, moverColor, beforeEval, bestBefore);
    }

    if (checkGameOver()) return;

    if (gameMode === "bot" && chess.turn() === "b" && !inSimulation) {
      setTimeout(() => {
        const botMove = pickBotMoveByElo();
        if (botMove) {
          const executed = chess.move(botMove);
          moveHistory.push(executed);
          viewIndex = moveHistory.length - 1;
          renderMoveList();
          playSound(chess.in_check() ? "check" : executed.captured ? "capture" : "move");
          renderBoard();
          checkGameOver();
        }
      }, 280);
    }
  }

  function evaluateMoveForLiveCoach(move, color, beforeEval, bestBefore) {
    const afterEval = evaluateBoardStatic(chess);
    const diff = color === "w" ? (afterEval - beforeEval) : (beforeEval - afterEval);
    const idx = moveHistory.length - 1;

    let rating = { symbol: "✓", css: "tag-good", label: lang === "pt" ? "Bom lance" : "Good move" };
    let cardType = "";
    let msg = "";
    let showUndoSuggestion = false;

    const bestSan = bestBefore && bestBefore.move ? bestBefore.move.san : null;
    const playedBest = bestSan && bestSan === move.san;

    if (chess.in_checkmate()) {
      rating = { symbol: "!!", css: "tag-brilliant", label: "Xeque-Mate!" };
      cardType = "great";
      msg = lang === "pt" ? `Brilhante! <strong>${move.san}</strong> termina a partida em xeque-mate.` : `Brilliant! <strong>${move.san}</strong> finishes the game with checkmate.`;
    } else if (diff <= -250) {
      rating = { symbol: "??", css: "tag-blunder", label: "Blunder (Erro Grave)" };
      cardType = "blunder";
      showUndoSuggestion = true;
      const reason = detectBlunderReason(move);
      msg = lang === "pt"
        ? `Cuidado! <strong>${move.san}</strong> foi um <strong>Blunder</strong>. ${reason} ${bestSan ? `Jogar <strong>${bestSan}</strong> era muito mais seguro.` : ""}`
        : `Careful! <strong>${move.san}</strong> was a <strong>Blunder</strong>. ${reason} ${bestSan ? `Playing <strong>${bestSan}</strong> was much safer.` : ""}`;
      if (bestBefore && bestBefore.move) currentArrow = { from: bestBefore.move.from, to: bestBefore.move.to, color: "#10b981" };
    } else if (diff <= -110) {
      rating = { symbol: "?", css: "tag-mistake", label: lang === "pt" ? "Erro" : "Mistake" };
      cardType = "mistake";
      showUndoSuggestion = true;
      msg = lang === "pt"
        ? `Olha, talvez jogar <strong>${bestSan || "outra jogada"}</strong> fosse melhor do que <strong>${move.san}</strong>, pois perdeste vantagem posicional ou material.`
        : `Look, playing <strong>${bestSan || "another move"}</strong> might have been stronger than <strong>${move.san}</strong>, as you lost material or positional control.`;
      if (bestBefore && bestBefore.move) currentArrow = { from: bestBefore.move.from, to: bestBefore.move.to, color: "#f59e0b" };
    } else if (playedBest || diff >= 120) {
      rating = { symbol: "★", css: "tag-best", label: lang === "pt" ? "Melhor Jogada" : "Best Move" };
      cardType = "great";
      msg = lang === "pt"
        ? `Excelente escolha com <strong>${move.san}</strong>! Manténs a iniciativa e pressionas a posição adversária.`
        : `Great choice with <strong>${move.san}</strong>! You keep the initiative and pressure your opponent.`;
    } else {
      msg = lang === "pt"
        ? `Lance sólido (<strong>${move.san}</strong>). Continua a desenvolver as peças e a proteger o teu Rei.`
        : `Solid move (<strong>${move.san}</strong>). Keep developing your pieces and protecting your King.`;
    }

    moveRatings[idx] = rating;
    renderMoveList();
    renderBoard();

    pushCoachMessage(
      `${rating.symbol} ${move.san} — ${rating.label}`,
      msg,
      cardType,
      showUndoSuggestion
    );
  }

  function detectBlunderReason(move) {
    const oppMoves = chess.moves({ verbose: true });
    const captureOnMovedPiece = oppMoves.find(m => m.to === move.to && m.captured);
    if (captureOnMovedPiece) {
      return lang === "pt"
        ? `Deixaste a tua peça em <strong>${move.to}</strong> desprotegida para captura (${captureOnMovedPiece.san}).`
        : `You left your piece on <strong>${move.to}</strong> undefended for capture (${captureOnMovedPiece.san}).`;
    }
    const bigCapture = oppMoves.find(m => m.captured === "q" || m.captured === "r");
    if (bigCapture) {
      return lang === "pt"
        ? `Permites ao adversário capturar material importante com <strong>${bigCapture.san}</strong>.`
        : `You allow your opponent to win key material with <strong>${bigCapture.san}</strong>.`;
    }
    return lang === "pt"
      ? "Este lance enfraquece a defesa do teu Rei ou cede contra-jogo tático imediato."
      : "This move weakens your King's safety or gives away immediate tactical counterplay.";
  }

  function pushCoachMessage(title, htmlBody, type = "", withUndoBtn = false) {
    const feed = document.getElementById("coach-feed");
    const card = document.createElement("div");
    card.className = `coach-card ${type}`;
    card.innerHTML = `
      <div class="coach-head"><span>${title}</span></div>
      <div>${htmlBody}</div>
      ${withUndoBtn ? `<div><button class="warning" style="padding:5px 9px;font-size:0.78rem;" onclick="undoMove()">↩ ${lang === "pt" ? "Desfazer e Tentar Outra" : "Undo & Try Again"}</button></div>` : ""}
    `;
    feed.prepend(card);
  }

  /* ================= UNDO MOVE ================= */
  function undoMove() {
    if (gameMode === "puzzle") {
      loadCurrentPuzzle();
      return;
    }
    if (!moveHistory.length) return;
    if (inSimulation) exitSimulation();

    const stepsToUndo = (gameMode === "bot" && chess.turn() === "w" && moveHistory.length >= 2) ? 2 : 1;
    for (let i = 0; i < stepsToUndo; i++) {
      if (moveHistory.length > 0) {
        delete moveRatings[moveHistory.length - 1];
        moveHistory.pop();
      }
    }

    chess.reset();
    for (const m of moveHistory) chess.move(m);
    viewIndex = moveHistory.length - 1;
    selectedSq = null;
    legalTargets = [];
    clearBoardHighlights(false);
    closeGameOverModal();
    renderMoveList();
    renderBoard();

    pushCoachMessage(
      lang === "pt" ? "↩ Jogada desfeita" : "↩ Move undone",
      lang === "pt" ? "Boa! Tenta encontrar agora uma continuação mais forte." : "Good! Now try to find a stronger continuation."
    );
  }

  function toggleLiveCoach() {
    liveCoachEnabled = !liveCoachEnabled;
    document.getElementById("live-coach-btn").classList.toggle("active-pill", liveCoachEnabled);
  }

  /* ================= COACH QUICK BUTTONS ================= */
  function coachExplainMove() {
    if (viewIndex < 0) {
      pushCoachMessage("🎓 ChessLab", lang === "pt" ? "Faz primeiro um lance no tabuleiro para eu o analisar!" : "Make a move on the board first so I can analyze it!");
      return;
    }
    const m = moveHistory[viewIndex];
    const r = moveRatings[viewIndex];
    pushCoachMessage(
      `💡 ${m.san}`,
      r
        ? (lang === "pt" ? `Este lance foi classificado como <strong>${r.label}</strong>. Observa se todas as tuas peças ficaram defendidas e se o teu Rei está seguro.` : `This move was rated as <strong>${r.label}</strong>. Check if all your pieces remain defended and your King is safe.`)
        : (lang === "pt" ? `Lance jogado: <strong>${m.san}</strong>. Clica em "Analisar" na coluna esquerda para calcular a precisão completa.` : `Played move: <strong>${m.san}</strong>. Click "Analyze" on the left column for full accuracy evaluation.`)
    );
  }

  function coachShowPlan() {
    clearBoardHighlights(false);
    const turn = chess.turn();
    const targets = turn === "w" ? ["e4", "d4", "c4", "f3", "c3"] : ["e5", "d5", "c5", "f6", "c6"];
    highlightSquares.plan = targets.filter(sq => !chess.get(sq));
    renderBoard();
    pushCoachMessage(
      lang === "pt" ? "🧭 Plano Estratégico" : "🧭 Strategic Plan",
      lang === "pt"
        ? "Controla as casas centrais destacadas a azul, desenvolve os Cavalos e Bispos antes de mover a Dama repetidamente e faz o roque cedo."
        : "Control the highlighted central squares in blue, develop Knights and Bishops before moving the Queen repeatedly, and castle early."
    );
  }

  function coachShowThreats() {
    clearBoardHighlights(false);
    const oppMoves = chess.moves({ verbose: true });
    const threats = [...new Set(oppMoves.filter(m => m.captured).map(m => m.to))];
    highlightSquares.threat = threats;
    renderBoard();
    pushCoachMessage(
      lang === "pt" ? "⚠️ Ameaças na Posição" : "⚠️ Threats on Board",
      threats.length
        ? (lang === "pt" ? `Atenção às casas destacadas a vermelho (<strong>${threats.join(", ")}</strong>): existem capturas possíveis ali!` : `Watch the red highlighted squares (<strong>${threats.join(", ")}</strong>): captures are available there!`)
        : (lang === "pt" ? "Não existem capturas imediatas neste turno. Aproveita para melhorar a pior peça." : "No immediate captures this turn. Take the chance to improve your worst-placed piece.")
    );
  }

  function clearBoardHighlights(redraw = true) {
    highlightSquares = { hint: [], threat: [], plan: [] };
    currentArrow = null;
    if (redraw) renderBoard();
  }

  /* ================= FULL GAME ANALYSIS ================= */
  function analyzeFullGame() {
    if (!moveHistory.length) return;
    const temp = new Chess();
    let wScoreSum = 0, wCount = 0, bScoreSum = 0, bCount = 0;

    moveHistory.forEach((m, i) => {
      const before = evaluateBoardStatic(temp);
      const color = temp.turn();
      temp.move(m);
      const after = evaluateBoardStatic(temp);
      const diff = color === "w" ? (after - before) : (before - after);

      let acc = 100;
      if (diff <= -250) { moveRatings[i] = { symbol: "??", css: "tag-blunder", label: "Blunder" }; acc = 20; }
      else if (diff <= -110) { moveRatings[i] = { symbol: "?", css: "tag-mistake", label: "Mistake" }; acc = 50; }
      else if (diff <= -45) { moveRatings[i] = { symbol: "?!", css: "tag-inaccuracy", label: "Inaccuracy" }; acc = 75; }
      else if (diff >= 120) { moveRatings[i] = { symbol: "★", css: "tag-best", label: "Best" }; acc = 100; }
      else { moveRatings[i] = { symbol: "✓", css: "tag-good", label: "Good" }; acc = 92; }

      if (color === "w") { wScoreSum += acc; wCount++; }
      else { bScoreSum += acc; bCount++; }
    });

    document.getElementById("accuracy-bar").style.display = "flex";
    document.getElementById("acc-white").textContent = wCount ? `${Math.round(wScoreSum / wCount)}%` : "-";
    document.getElementById("acc-black").textContent = bCount ? `${Math.round(bScoreSum / bCount)}%` : "-";
    renderMoveList();
    renderBoard();
    switchTab("coach");
    pushCoachMessage(
      lang === "pt" ? "🔍 Análise Concluída" : "🔍 Analysis Complete",
      lang === "pt" ? "Clica em qualquer lance na coluna esquerda para ver os emblemas no tabuleiro e a explicação do treinador." : "Click any move on the left column to see board badges and coach explanations."
    );
  }

  /* ================= MOVE LIST & NAVIGATION ================= */
  function renderMoveList() {
    const list = document.getElementById("moves-list");
    list.innerHTML = "";
    for (let i = 0; i < moveHistory.length; i += 2) {
      const row = document.createElement("div");
      row.className = "move-row";
      const num = document.createElement("span");
      num.className = "move-num";
      num.textContent = `${Math.floor(i / 2) + 1}.`;
      row.appendChild(num);

      [i, i + 1].forEach(idx => {
        const cell = document.createElement("div");
        if (moveHistory[idx]) {
          cell.className = `move-cell ${idx === viewIndex ? "active" : ""}`;
          const r = moveRatings[idx];
          cell.innerHTML = `<span>${moveHistory[idx].san}</span>${r ? `<span class="badge-tag ${r.css}">${r.symbol}</span>` : ""}`;
          cell.onclick = () => goToMove(idx);
        }
        row.appendChild(cell);
      });
      list.appendChild(row);
    }
    list.scrollTop = list.scrollHeight;
  }

  function goToMove(idx) {
    if (idx < -1 || idx >= moveHistory.length) return;
    viewIndex = idx;
    chess.reset();
    for (let i = 0; i <= idx; i++) chess.move(moveHistory[i]);
    selectedSq = null;
    legalTargets = [];
    clearBoardHighlights(false);
    renderMoveList();
    renderBoard();
  }

  function exitSimulation() {
    inSimulation = false;
    document.getElementById("sim-banner").style.display = "none";
    if (savedHistoryBeforeSim) {
      moveHistory = savedHistoryBeforeSim;
      goToMove(moveHistory.length - 1);
    }
  }

  /* ================= PUZZLE MODE LOGIC ================= */
  function loadNextPuzzle() {
    const filter = document.getElementById("pz-filter").value;
    const pool = filter === "all" ? PUZZLES : PUZZLES.filter(p => String(p.movesToMate) === filter);
    const candidates = pool.filter(p => !currentPuzzle || p.id !== currentPuzzle.id);
    currentPuzzle = candidates[Math.floor(Math.random() * candidates.length)] || pool[0];
    loadCurrentPuzzle();
  }

  function loadCurrentPuzzle() {
    if (!currentPuzzle) return;
    puzzleStep = 0;
    chess.load(currentPuzzle.fen);
    moveHistory = [];
    viewIndex = -1;
    moveRatings = {};
    selectedSq = null;
    legalTargets = [];
    clearBoardHighlights(false);
    boardFlipped = chess.turn() === "b";
    renderMoveList();
    renderBoard();
    renderCurrentPuzzleText();
  }

  function renderCurrentPuzzleText() {
    if (!currentPuzzle) return;
    document.getElementById("pz-title").textContent = lang === "pt" ? currentPuzzle.titlePt : currentPuzzle.titleEn;
    document.getElementById("pz-desc").textContent = lang === "pt" ? currentPuzzle.descPt : currentPuzzle.descEn;
  }

  function handlePuzzleUserMove(from, to, promotion) {
    const expected = currentPuzzle.solution[puzzleStep];
    const uci = from + to;
    if (expected && uci === expected.slice(0, 4)) {
      const m = chess.move({ from, to, promotion });
      moveHistory.push(m);
      viewIndex = moveHistory.length - 1;
      puzzleStep++;
      selectedSq = null;
      legalTargets = [];
      clearBoardHighlights(false);
      playSound(chess.in_check() ? "check" : "move");
      renderMoveList();
      renderBoard();

      if (puzzleStep >= currentPuzzle.solution.length) {
        pzSolvedCount++;
        pzStreakCount++;
        document.getElementById("pz-solved").textContent = pzSolvedCount;
        document.getElementById("pz-streak").textContent = `${pzStreakCount} 🔥`;
        document.getElementById("pz-desc").innerHTML = `<strong style="color:var(--success);">✅ ${lang === "pt" ? "Excelente! Puzzle resolvido!" : "Awesome! Puzzle solved!"}</strong>`;
        return;
      }

      setTimeout(() => {
        const replyUci = currentPuzzle.solution[puzzleStep];
        const reply = chess.move({ from: replyUci.slice(0, 2), to: replyUci.slice(2, 4), promotion: "q" });
        if (reply) {
          moveHistory.push(reply);
          viewIndex = moveHistory.length - 1;
          puzzleStep++;
          renderMoveList();
          renderBoard();
        }
      }, 320);
    } else {
      pzStreakCount = 0;
      document.getElementById("pz-streak").textContent = "0 🔥";
      selectedSq = null;
      legalTargets = [];
      renderBoard();
      document.getElementById("pz-desc").innerHTML = `<strong style="color:var(--danger);">❌ ${lang === "pt" ? "Esse lance não força o mate. Tenta outra vez!" : "That move doesn't force mate. Try again!"}</strong>`;
    }
  }

  function puzzleHint() {
    if (!currentPuzzle || puzzleStep >= currentPuzzle.solution.length) return;
    const from = currentPuzzle.solution[puzzleStep].slice(0, 2);
    highlightSquares.hint = [from];
    renderBoard();
  }

  function puzzleSolution() {
    if (!currentPuzzle || puzzleStep >= currentPuzzle.solution.length) return;
    const step = currentPuzzle.solution[puzzleStep];
    currentArrow = { from: step.slice(0, 2), to: step.slice(2, 4), color: "#10b981" };
    renderBoard();
  }

  /* ================= IMPORT FROM CHESS.COM & LICHESS ================= */
  async function fetchExternalGames() {
    const ccUser = document.getElementById("chesscom-user").value.trim();
    const liUser = document.getElementById("lichess-user").value.trim();
    const statusEl = document.getElementById("import-status");
    const listEl = document.getElementById("imported-games-list");
    listEl.innerHTML = "";

    if (!ccUser && !liUser) {
      statusEl.textContent = lang === "pt" ? "Escreve pelo menos um nome de utilizador." : "Enter at least one username.";
      return;
    }
    statusEl.textContent = lang === "pt" ? "A procurar partidas..." : "Fetching games...";
    let results = [];

    if (ccUser) {
      try {
        const archRes = await fetch(`https://api.chess.com/pub/player/${encodeURIComponent(ccUser)}/games/archives`);
        if (archRes.ok) {
          const { archives } = await archRes.json();
          if (archives && archives.length) {
            const lastMonth = await fetch(archives[archives.length - 1]);
            const { games } = await lastMonth.json();
            games.slice(-8).reverse().forEach(g => {
              if (g.pgn) results.push({ site: "Chess.com", white: g.white.username, black: g.black.username, pgn: g.pgn });
            });
          }
        }
      } catch (_) {}
    }

    if (liUser) {
      try {
        const liRes = await fetch(`https://lichess.org/api/games/user/${encodeURIComponent(liUser)}?max=8&pgnInJson=true`, {
          headers: { Accept: "application/x-ndjson" }
        });
        if (liRes.ok) {
          const text = await liRes.text();
          text.trim().split("\n").forEach(line => {
            if (!line) return;
            const g = JSON.parse(line);
            const w = g.players?.white?.user?.name || "White";
            const b = g.players?.black?.user?.name || "Black";
            if (g.pgn) results.push({ site: "Lichess", white: w, black: b, pgn: g.pgn });
          });
        }
      } catch (_) {}
    }

    if (!results.length) {
      statusEl.textContent = lang === "pt" ? "Nenhuma partida pública encontrada para esse utilizador." : "No public games found for that username.";
      return;
    }

    statusEl.textContent = `${results.length} ${lang === "pt" ? "partidas encontradas:" : "games found:"}`;
    results.forEach(g => {
      const item = document.createElement("div");
      item.className = "game-item";
      item.innerHTML = `<strong>[${g.site}] ${g.white} vs ${g.black}</strong><span style="color:var(--text-muted);font-size:0.75rem;">${lang === "pt" ? "Clica para carregar e analisar" : "Click to load & analyze"}</span>`;
      item.onclick = () => loadPgnIntoBoard(g.pgn, g.white, g.black);
      listEl.appendChild(item);
    });
  }

  function loadPgnIntoBoard(pgn, white, black) {
    const loader = new Chess();
    if (!loader.load_pgn(pgn)) return;
    gameMode = "pvp";
    document.getElementById("mode-select").value = "pvp";
    moveHistory = loader.history({ verbose: true });
    moveRatings = {};
    document.getElementById("top-name").textContent = black;
    document.getElementById("bottom-name").textContent = white;
    goToMove(moveHistory.length - 1);
    analyzeFullGame();
  }

  /* ================= GAME OVER & UI HELPERS ================= */
  function checkGameOver() {
    if (!chess.game_over()) return false;
    let title = lang === "pt" ? "Fim da Partida!" : "Game Over!";
    let sub = "";
    let icon = "🤝";

    if (chess.in_checkmate()) {
      const winner = chess.turn() === "w" ? (lang === "pt" ? "Pretas vencem!" : "Black wins!") : (lang === "pt" ? "Brancas vencem!" : "White wins!");
      title = winner;
      sub = lang === "pt" ? "Vitória por xeque-mate" : "Victory by checkmate";
      icon = "🏆";
    } else if (chess.in_threefold_repetition()) {
      title = lang === "pt" ? "Empate!" : "Draw!";
      sub = lang === "pt" ? "Empate por tripla repetição" : "Draw by threefold repetition";
    } else if (chess.in_stalemate()) {
      title = lang === "pt" ? "Empate!" : "Draw!";
      sub = lang === "pt" ? "Empate por afogamento" : "Draw by stalemate";
    } else {
      title = lang === "pt" ? "Empate!" : "Draw!";
      sub = lang === "pt" ? "Material insuficiente ou regra dos 50 lances" : "Insufficient material or 50-move rule";
    }

    document.getElementById("go-icon").textContent = icon;
    document.getElementById("go-title").textContent = title;
    document.getElementById("go-sub").textContent = sub;
    document.getElementById("gameover-modal").classList.add("open");
    return true;
  }

  function closeGameOverModal() { document.getElementById("gameover-modal").classList.remove("open"); }
  function closeModalAndAnalyze() { closeGameOverModal(); analyzeFullGame(); }
  function closeModalAndReset() { closeGameOverModal(); resetGame(); }

  function onModeChange() {
    gameMode = document.getElementById("mode-select").value;
    document.getElementById("bot-elo").style.display = gameMode === "bot" ? "inline-block" : "none";
    updatePlayerLabels();
    if (gameMode === "puzzle") {
      switchTab("puzzles");
      loadNextPuzzle();
    } else {
      switchTab("coach");
      resetGame();
    }
  }

  function updatePlayerLabels() {
    if (gameMode === "bot") {
      document.getElementById("top-icon").textContent = "🤖";
      document.getElementById("top-name").textContent = "Stockfish Bot";
      document.getElementById("top-elo").textContent = document.getElementById("bot-elo").value;
      document.getElementById("bottom-name").textContent = lang === "pt" ? "Tu (Brancas)" : "You (White)";
    } else if (gameMode === "pvp") {
      document.getElementById("top-icon").textContent = "🧑";
      document.getElementById("top-name").textContent = lang === "pt" ? "Jogador 2 (Pretas)" : "Player 2 (Black)";
      document.getElementById("top-elo").textContent = "Local";
      document.getElementById("bottom-name").textContent = lang === "pt" ? "Jogador 1 (Brancas)" : "Player 1 (White)";
    } else {
      document.getElementById("top-icon").textContent = "🧩";
      document.getElementById("top-name").textContent = lang === "pt" ? "Desafio Tático" : "Tactical Challenge";
      document.getElementById("top-elo").textContent = "Puzzle";
    }
  }

  function resetGame() {
    if (gameMode === "puzzle") { loadNextPuzzle(); return; }
    chess.reset();
    moveHistory = [];
    viewIndex = -1;
    moveRatings = {};
    selectedSq = null;
    legalTargets = [];
    inSimulation = false;
    document.getElementById("sim-banner").style.display = "none";
    document.getElementById("accuracy-bar").style.display = "none";
    document.getElementById("coach-feed").innerHTML = "";
    clearBoardHighlights(false);
    renderMoveList();
    renderBoard();
    pushCoachMessage(
      "🎓 ChessLab Coach",
      lang === "pt"
        ? "Partida iniciada! O Treinador ao Vivo está ativo e vai avisar-te se cometeres algum erro ou deixares escapar uma tática."
        : "Game started! Live Coach is active and will alert you if you make a mistake or miss a tactic."
    );
  }

  function switchTab(name) {
    ["coach", "puzzles", "import"].forEach(t => {
      document.getElementById(`tab-${t}`).classList.toggle("active", t === name);
      document.getElementById(`tab-btn-${t}`).classList.toggle("active", t === name);
    });
  }

  function changeTheme(cls) { document.body.className = cls; }
  function flipBoard() { boardFlipped = !boardFlipped; renderBoard(); }

  /* INIT */
  resetGame();
</script>
</body>
