  const PIECE_VAL = { p: 100, n: 320, b: 330, r: 500, q: 900, k: 20000 };

  function evaluateBoardStatic(game) {
    if (game.in_checkmate()) return game.turn() === "w" ? -9999 : 9999;
    if (game.in_draw()) return 0;
    let score = 0;
    const b = game.board();
    for (let r = 0; r < 8; r++) {
      for (let c = 0; c < 8; c++) {
        const p = b[r][c];
        if (!p) continue;
        let val = PIECE_VAL[p.type] || 0;
        if ((r === 3 || r === 4) && (c === 3 || c === 4)) val += 18;
        score += p.color === "w" ? val : -val;
      }
    }
    return score;
  }

  function findBestMoveMinimax(game, depth) {
    const moves = game.moves({ verbose: true });
    if (!moves.length) return null;
    const isMax = game.turn() === "w";
    let bestMove = moves[0];
    let bestVal = isMax ? -Infinity : Infinity;

    for (const m of moves) {
      game.move(m);
      const val = minimax(game, depth - 1, -Infinity, Infinity, !isMax);
      game.undo();
      if (isMax && val > bestVal) { bestVal = val; bestMove = m; }
      if (!isMax && val < bestVal) { bestVal = val; bestMove = m; }
    }
    return { move: bestMove, score: bestVal };
  }

  function minimax(game, depth, alpha, beta, isMax) {
    if (depth === 0 || game.game_over()) return evaluateBoardStatic(game);
    const moves = game.moves({ verbose: true });
