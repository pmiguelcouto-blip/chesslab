<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="ChessLab" />
  <title>ChessLab — Treino, Análise & Puzzles</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
  <style>
    :root {
      --bg-app: #0b1120;
      --bg-panel: #111827;
      --bg-card: #1e293b;
      --bg-hover: #283548;
      --border: #2d3b52;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #6366f1;
      --accent-hover: #4f46e5;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --sq-light: #e2e8f0;
      --sq-dark: #475569;
    }

    body.theme-green { --sq-light: #ebecd0; --sq-dark: #739552; }
    body.theme-wood { --sq-light: #f0d9b5; --sq-dark: #b58863; }
    body.theme-ocean { --sq-light: #dee3e6; --sq-dark: #5d8aa8; }
    body.theme-slate { --sq-light: #cbd5e1; --sq-dark: #475569; }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body {
      background: var(--bg-app);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* TOPBAR */
    header {
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border);
      padding: 10px 16px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 1.2rem;
      letter-spacing: -0.02em;
    }
    .brand-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #6366f1, #10b981);
      border-radius: 8px;
      display: grid;
      place-items: center;
      font-size: 1.1rem;
    }

    .controls-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    select, button, input {
      background: var(--bg-card);
      color: var(--text-main);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 7px 11px;
      font-size: 0.85rem;
      outline: none;
      transition: all 0.15s ease;
    }
    button { cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
    button:hover:not(:disabled) { background: var(--bg-hover); border-color: #475569; }
    button:disabled { opacity: 0.45; cursor: not-allowed; }
    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    button.primary:hover:not(:disabled) { background: var(--accent-hover); }
    button.success { background: var(--success); border-color: var(--success); color: #052e16; }
    button.warning { background: rgba(245, 158, 11, 0.18); border-color: var(--warning); color: #fcd34d; }
    button.active-pill { background: rgba(99, 102, 241, 0.25); border-color: var(--accent); color: #c7d2fe; }

    /* MAIN 3-COLUMN LAYOUT */
    .workspace {
      flex: 1;
      display: grid;
      grid-template-columns: 280px minmax(320px, 560px) 360px;
      justify-content: center;
      gap: 16px;
      padding: 16px;
      max-width: 1360px;
      width: 100%;
      margin: 0 auto;
    }

    .panel {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      max-height: calc(100vh - 88px);
    }

    .panel-header {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 700;
      font-size: 0.92rem;
    }

    /* LEFT COLUMN: MOVES */
    .moves-list {
      flex: 1;
      overflow-y: auto;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .move-row {
      display: grid;
      grid-template-columns: 36px 1fr 1fr;
      align-items: center;
      font-size: 0.86rem;
      border-radius: 6px;
      padding: 3px 6px;
    }
    .move-row:nth-child(odd) { background: rgba(255,255,255,0.02); }
    .move-num { color: var(--text-muted); font-size: 0.78rem; }
    .move-cell {
      padding: 4px 8px;
      border-radius: 5px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
    }
    .move-cell:hover { background: var(--bg-hover); }
    .move-cell.active { background: var(--accent); color: #fff; font-weight: 700; }

    .badge-tag {
      font-size: 0.7rem;
      font-weight: 800;
      padding: 1px 5px;
      border-radius: 4px;
    }
    .tag-brilliant { background: #06b6d4; color: #083344; }
    .tag-best { background: #10b981; color: #052e16; }
    .tag-good { background: #3b82f6; color: #fff; }
    .tag-inaccuracy { background: #f59e0b; color: #451a03; }
    .tag-mistake { background: #f97316; color: #431407; }
    .tag-blunder { background: #ef4444; color: #fff; }

    .nav-bar {
      padding: 10px;
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }
    .nav-bar button { justify-content: center; padding: 8px; }

    /* CENTER COLUMN: BOARD */
    .board-column {
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
    }
    .player-strip {
      width: 100%;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.88rem;
    }
    .player-meta { display: flex; align-items: center; gap: 8px; font-weight: 600; }
    .elo-pill {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 2px 7px;
      border-radius: 999px;
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .board-area {
      width: 100%;
      display: flex;
      gap: 10px;
      align-items: stretch;
    }

    .eval-bar-wrap {
      width: 18px;
      background: #1e293b;
      border-radius: 8px;
      border: 1px solid var(--border);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      position: relative;
    }
    .eval-fill {
      width: 100%;
      height: 50%;
      background: #f8fafc;
      transition: height 0.35s ease;
    }
    .eval-label {
      position: absolute;
      top: 4px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.62rem;
      font-weight: 800;
      color: #94a3b8;
      writing-mode: vertical-rl;
    }

    #board-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 10px;
      overflow: hidden;
      border: 2px solid var(--border);
      box-shadow: 0 14px 35px rgba(0,0,0,0.45);
      user-select: none;
      touch-action: manipulation;
    }

    #chessboard {
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      grid-template-rows: repeat(8, 1fr);
    }

    .square {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .square.light { background: var(--sq-light); }
    .square.dark { background: var(--sq-dark); }
    .square.selected { box-shadow: inset 0 0 0 4px rgba(99, 102, 241, 0.85); }
    .square.last-move::after {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(250, 204, 21, 0.34);
      pointer-events: none;
    }
    .square.hint-sq { box-shadow: inset 0 0 0 4px #10b981; animation: pulseHint 1.2s infinite; }
    .square.threat-sq { box-shadow: inset 0 0 0 4px rgba(239, 68, 68, 0.85); }
    .square.plan-sq { box-shadow: inset 0 0 0 4px rgba(56, 189, 248, 0.85); }

    @keyframes pulseHint {
      0%, 100% { box-shadow: inset 0 0 0 4px rgba(16, 185, 129, 0.95); }
      50% { box-shadow: inset 0 0 0 7px rgba(16, 185, 129, 0.35); }
    }

    .legal-dot {
      width: 28%;
      height: 28%;
      border-radius: 50%;
      background: rgba(15, 23, 42, 0.28);
      pointer-events: none;
      z-index: 2;
    }
    .legal-ring {
      position: absolute;
      inset: 8%;
      border-radius: 50%;
      border: 4px solid rgba(15, 23, 42, 0.32);
      pointer-events: none;
      z-index: 2;
    }

    .coord-file, .coord-rank {
      position: absolute;
      font-size: 0.65rem;
      font-weight: 700;
      pointer-events: none;
      opacity: 0.78;
    }
    .coord-file { bottom: 2px; right: 4px; }
    .coord-rank { top: 2px; left: 4px; }
    .square.light .coord-file, .square.light .coord-rank { color: var(--sq-dark); }
    .square.dark .coord-file, .square.dark .coord-rank { color: var(--sq-light); }

    .piece-svg {
      width: 84%;
      height: 84%;
      z-index: 3;
      pointer-events: none;
      filter: drop-shadow(0 2px 2px rgba(0,0,0,0.35));
    }

    .sq-badge {
      position: absolute;
      top: 2px;
      right: 2px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      font-size: 0.66rem;
      font-weight: 900;
      display: grid;
      place-items: center;
      z-index: 5;
      box-shadow: 0 2px 5px rgba(0,0,0,0.45);
      pointer-events: none;
    }

    #arrow-overlay {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 6;
    }

    /* RIGHT COLUMN: TABS (COACH, PUZZLES, IMPORT) */
    .tabs-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--border);
      background: rgba(15, 23, 42, 0.5);
    }
    .tab-btn {
      border: none;
      border-radius: 0;
      background: transparent;
      padding: 11px 6px;
      font-size: 0.82rem;
      justify-content: center;
      color: var(--text-muted);
      border-bottom: 2px solid transparent;
    }
    .tab-btn.active {
      color: var(--text-main);
      border-bottom-color: var(--accent);
      background: rgba(99, 102, 241, 0.08);
    }

    .tab-content {
      flex: 1;
      overflow-y: auto;
      padding: 14px;
      display: none;
      flex-direction: column;
      gap: 12px;
    }
    .tab-content.active { display: flex; }

    /* COACH FEED */
    .coach-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      line-height: 1.45;
      font-size: 0.87rem;
    }
    .coach-card.blunder { border-left: 4px solid var(--danger); }
    .coach-card.mistake { border-left: 4px solid #f97316; }
    .coach-card.great { border-left: 4px solid var(--success); }
    .coach-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 700;
      font-size: 0.85rem;
    }
    .quick-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .quick-actions button { font-size: 0.78rem; padding: 6px 9px; }

    /* PUZZLE BOX */
    .puzzle-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .puzzle-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .stat-tile {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 10px;
      text-align: center;
    }
    .stat-val { font-size: 1.15rem; font-weight: 800; color: var(--success); }
    .stat-lbl { font-size: 0.72rem; color: var(--text-muted); }

    /* IMPORT LIST */
    .game-item {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 9px 11px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 0.82rem;
    }
    .game-item:hover { border-color: var(--accent); background: var(--bg-hover); }

    /* GAME OVER MODAL — FIXED Z-INDEX ABOVE ALL PIECES */
    #gameover-modal {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.78);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 9999;
    }
    #gameover-modal.open { display: flex; }
    .modal-card {
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 18px;
      padding: 24px 22px;
      max-width: 390px;
      width: 100%;
      text-align: center;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75);
      display: flex;
      flex-direction: column;
      gap: 14px;
      position: relative;
      z-index: 10000;
    }
    .modal-icon {
      width: 54px;
      height: 54px;
      margin: 0 auto;
      border-radius: 14px;
      background: rgba(16, 185, 129, 0.16);
      border: 1px solid rgba(16, 185, 129, 0.35);
      display: grid;
      place-items: center;
      font-size: 1.7rem;
    }
    .modal-title { font-size: 1.45rem; font-weight: 800; }
    .modal-sub { color: var(--text-muted); font-size: 0.92rem; }
    .modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    /* PROMOTION MODAL */
    #promo-modal {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.75);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9998;
    }
    #promo-modal.open { display: flex; }
    .promo-choices {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      padding: 16px;
      border-radius: 14px;
      display: flex;
      gap: 12px;
    }
    .promo-btn { width: 64px; height: 64px; padding: 6px; justify-content: center; }

    @media (max-width: 1060px) {
      .workspace {
        grid-template-columns: 1fr;
        max-width: 600px;
      }
      .panel { max-height: none; }
      .moves-list { max-height: 200px; }
    }
  </style>
</head>
<body class="theme-green">

<header>
  <div class="brand">
    <div class="brand-icon">♞</div>
    <span>ChessLab</span>
  </div>

  <div class="controls-bar">
    <select id="mode-select" onchange="onModeChange()">
      <option value="bot" data-i18n="modeBot">Contra Bot</option>
      <option value="pvp" data-i18n="modePvp">2 Jogadores</option>
      <option value="puzzle" data-i18n="modePuzzle">Puzzles Táticos</option>
    </select>

    <select id="bot-elo" onchange="updatePlayerLabels()">
      <option value="400">Bot 400 ELO</option>
      <option value="800">Bot 800 ELO</option>
      <option value="1200" selected>Bot 1200 ELO</option>
      <option value="1600">Bot 1600 ELO</option>
      <option value="2000">Bot 2000 ELO</option>
      <option value="2500">Bot 2550+ ELO</option>
    </select>

    <button id="undo-btn" onclick="undoMove()" title="Desfazer última jogada">↩ <span data-i18n="undo">Desfazer</span></button>
    <button id="live-coach-btn" class="active-pill" onclick="toggleLiveCoach()">🎓 <span data-i18n="liveCoach">Treinador ao Vivo</span></button>
    <button class="primary" onclick="resetGame()">+ <span data-i18n="newGame">Novo Jogo</span></button>

    <select id="theme-select" onchange="changeTheme(this.value)" title="Cor do tabuleiro">
      <option value="theme-green">Verde</option>
      <option value="theme-wood">Madeira</option>
      <option value="theme-ocean">Oceano</option>
      <option value="theme-slate">Escuro</option>
    </select>

    <button onclick="flipBoard()" title="Rodar tabuleiro">⇅</button>
    <button id="lang-btn" onclick="toggleLanguage()">PT / EN</button>
  </div>
</header>

<main class="workspace">
  <!-- LEFT COLUMN: MOVES -->
  <section class="panel">
    <div class="panel-header">
      <span data-i18n="movesTitle">Lances da Partida</span>
      <button onclick="analyzeFullGame()" id="analyze-btn" style="padding:4px 8px;font-size:0.76rem;">🔍 <span data-i18n="analyze">Analisar</span></button>
    </div>
    <div id="accuracy-bar" style="display:none; padding:8px 12px; border-bottom:1px solid var(--border); font-size:0.8rem; justify-content:space-between; background:rgba(99,102,241,0.08);">
      <span>⬜ <strong id="acc-white">-</strong></span>
      <span>⬛ <strong id="acc-black">-</strong></span>
    </div>
    <div class="moves-list" id="moves-list"></div>
    <div class="nav-bar">
      <button onclick="goToMove(-1)">|&lt;</button>
      <button onclick="goToMove(viewIndex - 1)">&lt;</button>
      <button onclick="goToMove(viewIndex + 1)">&gt;</button>
      <button onclick="goToMove(moveHistory.length - 1)">&gt;|</button>
    </div>
  </section>

  <!-- CENTER COLUMN: BOARD -->
  <section class="board-column">
    <div class="player-strip">
      <div class="player-meta">
        <span id="top-icon">🤖</span>
        <span id="top-name">Stockfish Bot</span>
        <span class="elo-pill" id="top-elo">1200</span>
      </div>
      <div id="top-status" style="font-size:0.8rem;color:var(--text-muted);"></div>
    </div>

    <div class="board-area">
      <div class="eval-bar-wrap">
        <div class="eval-fill" id="eval-fill"></div>
        <span class="eval-label" id="eval-text">0.0</span>
      </div>

      <div id="board-wrapper">
        <div id="chessboard"></div>
        <svg id="arrow-overlay" viewBox="0 0 800 800"></svg>
      </div>
    </div>

    <div class="player-strip">
      <div class="player-meta">
        <span id="bottom-icon">🧑</span>
        <span id="bottom-name" data-i18n="you">Tu (Brancas)</span>
        <span class="elo-pill" id="bottom-elo">ChessLab</span>
      </div>
      <div id="sim-banner" style="display:none;">
        <button class="warning" style="padding:4px 8px;font-size:0.76rem;" onclick="exitSimulation()">↩ <span data-i18n="backToGame">Voltar à Partida</span></button>
      </div>
    </div>
  </section>

  <!-- RIGHT COLUMN: COACH / PUZZLES / IMPORT -->
  <section class="panel">
    <div class="tabs-bar">
      <button class="tab-btn active" id="tab-btn-coach" onclick="switchTab('coach')">🎓 <span data-i18n="tabCoach">Treinador</span></button>
      <button class="tab-btn" id="tab-btn-puzzles" onclick="switchTab('puzzles')">🧩 <span data-i18n="tabPuzzles">Puzzles</span></button>
      <button class="tab-btn" id="tab-btn-import" onclick="switchTab('import')">📥 <span data-i18n="tabImport">Importar</span></button>
    </div>

    <!-- TAB 1: COACH -->
    <div class="tab-content active" id="tab-coach">
      <div class="quick-actions">
        <button onclick="coachExplainMove()">💡 <span data-i18n="btnWhy">Porquê este lance?</span></button>
        <button onclick="coachShowPlan()">🧭 <span data-i18n="btnPlan">Qual o plano?</span></button>
        <button onclick="coachShowThreats()">⚠️ <span data-i18n="btnThreats">Ver ameaças</span></button>
        <button onclick="clearBoardHighlights()">🧹</button>
      </div>
      <div id="coach-feed" style="display:flex;flex-direction:column;gap:10px;"></div>
    </div>

    <!-- TAB 2: PUZZLES -->
    <div class="tab-content" id="tab-puzzles">
      <div class="puzzle-stats">
        <div class="stat-tile">
          <div class="stat-val" id="pz-solved">0</div>
          <div class="stat-lbl" data-i18n="pzSolved">Resolvidos</div>
        </div>
        <div class="stat-tile">
          <div class="stat-val" id="pz-streak">0 🔥</div>
          <div class="stat-lbl" data-i18n="pzStreak">Sequência</div>
        </div>
      </div>

      <div class="puzzle-box">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
          <select id="pz-filter" onchange="loadNextPuzzle()" style="flex:1;">
            <option value="all" data-i18n="pzAll">Todos (Mate em 1, 2 e 3)</option>
            <option value="1" data-i18n="pzM1">Mate em 1 Lance</option>
            <option value="2" data-i18n="pzM2">Mate em 2 Lances</option>
            <option value="3" data-i18n="pzM3">Mate em 3 Lances</option>
          </select>
          <button class="primary" onclick="loadNextPuzzle()" data-i18n="pzNext">Seguinte ➔</button>
        </div>

        <div id="pz-title" style="font-weight:800;font-size:0.95rem;">Puzzle #1</div>
        <div id="pz-desc" style="font-size:0.85rem;color:var(--text-muted);line-height:1.4;"></div>

        <div class="quick-actions">
          <button onclick="puzzleHint()">💡 <span data-i18n="pzHint">Dica</span></button>
